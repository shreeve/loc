use std.text


# Exactly SPEC's bytes: whitespace for the blank rule, and the bytes before a regex.
enum ByteSet
  whitespace
  regex_prev

fun byte_set[s: ByteSet] -> [256]Bool
  t = [256 of false]
  for b in 0..=U8.max
    t[b] = match s
      .whitespace => match b
        ' ', "\t", "\r", "\x0c", "\x0b" => true
        _ => false
      .regex_prev => match b
        '(', ',', '=', ':', '[', '!', '&', '|', '?', '{', '}', ';', '+', '-', '*', '%', '<', '>', '~', '^' => true
        _ => false
  t

WHITESPACE = byte_set[.whitespace]
REGEX_PREV = byte_set[.regex_prev]

fun is_ident(b: U8) -> Bool
  text.is_alpha(b) or text.is_digit(b) or b == '_' or b == '$'
