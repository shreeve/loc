# A walker task sends paths through a channel to counting tasks, whose sums
# merge at the end; no order can change a sum.

use std.file
use std.math
use std.slices
use std.task
use std.text

NUL_WINDOW = 8192     # a file is binary if a NUL byte appears this early
SMALL = 65536         # read whole to look at its head, in one call
MOST_WORKERS = 64     # task.workers' cap
COUNTERS = 64         # counting tasks; each waits out its file calls, so --jobs sets workers, not reads
WALKERS = 16          # walker tasks listing directories at once, overlapping their calls

obj Skipped
  files: Int = 0
  bytes: Int = 0

obj FileRow
  lang: Int
  path: String
  counts: Counts
  bytes: Int

obj Sums
  langs: List[Counts]
  files: List[Int]
  bytes: List[Int]
  text: Map[String, Skipped] = Map()
  binary: Map[String, Skipped] = Map()
  by_file: List[FileRow]? = none

  sub take(!@, table: ?Table, loaded: Loaded, path: String)
    match <loaded
      .counted(lang, buf)
        c = scan(table, lang, buf)
        !@langs[lang].add(c)
        @files[lang] += 1
        @bytes[lang] += buf.len
        if !@by_file as rows
          !rows.push(FileRow(lang: lang, path: <path, counts: c, bytes: buf.len))
      .text(label, n) => tally(!@text, <label, 1, n)
      .binary(label, n) => tally(!@binary, <label, 1, n)
      .unreadable(n) => tally(!@text, String("unreadable"), 1, n)
      .dropped => pass

  sub add(!@, o: Sums)
    for i in 0..@langs.len
      !@langs[i].add(o.langs[i])
      @files[i] += o.files[i]
      @bytes[i] += o.bytes[i]
    for e in ?o.text.items()
      tally(!@text, +e.key, e.value.files, e.value.bytes)
    for e in ?o.binary.items()
      tally(!@binary, +e.key, e.value.files, e.value.bytes)
    if <o.by_file as theirs and !@by_file as mine
      for r in <theirs
        !mine.push(<r)

fun empty_sums(langs: Int, by_file: Bool) -> Sums
  Sums(
    langs: List.filled(langs, Counts()),
    files: List.filled(langs, 0),
    bytes: List.filled(langs, 0),
    by_file: List[FileRow]() if by_file else none,
  )

sub tally(labels: !Map[String, Skipped], label: String, files: Int, bytes: Int)
  s = (!labels).ensure(<label, Skipped())
  s.files += files
  s.bytes += bytes

# With --only-lang an extensionless file is read for its #! line only when
# a counted language lists interpreters.
obj LangFilter
  excluded: List[Bool]
  only: Bool
  shebangs: Bool
  by_name: Bool  # whether a name alone can drop a file

fun lang_filter(table: ?Table, opts: ?Options) -> LangFilter
  if not opts.only_lang()
    return LangFilter(excluded: +opts.excluded_langs, only: false, shebangs: true, by_name: slices.contains(opts.excluded_langs, true))
  excluded: List[Bool] = List()
  shebangs = false
  for named, i in opts.only_langs
    !excluded.push(not named)
    shebangs = true if named and table.langs[i].shebangs.len > 0
  LangFilter(excluded: <excluded, only: true, shebangs: shebangs, by_name: true)

# The drops of `load` that read nothing, so the walker sends no such file.
fun dropped_by_name(table: ?Table, filter: ?LangFilter, name: ?String) -> Bool
  ext = extension(name)
  lower = ascii_lower(ext ?? "")
  lang = table.by_extension(lower) ?? table.by_file_name(name) ?? return filter.only and (ext != none or not filter.shebangs)
  ci = table.claimant(lower) ?? return filter.excluded[lang]
  filter.excluded[lang] and filter.excluded[ci]

# A device or FIFO PATH is read only up to the size it reports, as Rust's
# `take(size)` reads it, so a link to /dev/zero ends.
obj Job
  path: String
  device: Bool = false

pub fun count_trees(table: ?Table, opts: ?Options, checked: List[Root]) -> Sums!
  if opts.jobs as asked
    _ = task.workers(math.min(asked, MOST_WORKERS))  # before the first task, which starts the workers
  filter = lang_filter(table, opts)
  jobs = *Chan[Job](1024)
  # A counter starts as each of the first COUNTERS files is sent, so a small
  # tree starts few and an empty one none.
  asks = *Chan[Int](COUNTERS)
  w = walk_roots(table, ?filter, opts, <checked, +jobs, +asks)&
  ts = Tasks[Sums!]()
  while (!asks).recv()! != none
    !ts.add(counter(table, ?filter, +jobs, opts.by_file)&)
  done = (>ts)!
  >w!
  total = empty_sums(table.langs.len, opts.by_file)
  for s in <done
    !total.add(<s)
  total

# The blocking pool bounds the file calls in flight, which more would
# contend for in the kernel.
fun counter(table: ?Table, filter: ?LangFilter, jobs: *Chan[Job], by_file: Bool) -> Sums!
  s = empty_sums(table.langs.len, by_file)
  while (!jobs).recv()! as job
    loaded = load(table, filter, job.path, job.device)
    !s.take(table, <loaded, <job.path)
  s

enum Loaded
  counted(lang: Int, buf: String)
  text(label: String, bytes: Int)
  binary(label: String, bytes: Int)
  unreadable(bytes: Int)
  dropped  # excluded, or not named by --only-lang

# SPEC.md Files, in the Rust's order.
fun load(table: ?Table, filter: ?LangFilter, path: ?String, device: Bool) -> Loaded
  name = base_name(path)
  ext = extension(name)
  lower = ascii_lower(ext ?? "")
  li: Int? = table.by_extension(lower) ?? table.by_file_name(name)
  ready: String? = none  # the whole file, when its head was read whole
  if li == none and filter.only
    return .dropped if ext != none or not filter.shebangs
    head = read_head(path, device) catch |e| return unreadable(path, e)
    return .dropped if has_nul(head.bytes)
    li = interpreter_lang(table, head.bytes)
    return .dropped if li == none
    ready = <head.bytes if head.whole else none
  if li == none and table.binary_exts.has(lower)
    return .binary(label: lossy(lower), bytes: size_on_disk(path))
  if li == none and table.text_exts.has(lower)
    return .text(label: lossy(lower), bytes: size_on_disk(path))
  if li == none
    head = read_head(path, device) catch |e| return unreadable(path, e)
    return .binary(label: label_of(name, ext, lower), bytes: head.size) if has_nul(head.bytes)
    li = interpreter_lang(table, head.bytes) if ext == none
    return .text(label: label_of(name, ext, lower), bytes: head.size) if li == none
    ready = <head.bytes if head.whole else none
  lang = li ?? return .dropped
  excluded = ?filter.excluded
  claimant = table.claimant(lower)
  if claimant as ci and excluded[lang] != excluded[ci]
    # One of the two is excluded, so the first line decides.
    if ready == none
      head = read_head(path, device) catch |e| return unreadable(path, e)
      lang = ci if claims(table, ci, head.bytes)
      ready = <head.bytes if head.whole else none
    else if ?ready as whole
      lang = ci if claims(table, ci, whole)
    return .dropped if excluded[lang]
  else if excluded[lang]
    return .dropped  # with a claimant, both are excluded
  buf = <ready ?? (read_whole(path, device) catch |e| return unreadable(path, e))
  if claimant as ci and claims(table, ci, buf)  # the head's first line, so a second test agrees
    lang = ci
  return .binary(label: label_of(name, ext, lower), bytes: buf.len) if has_nul(buf)
  .counted(lang: lang, buf: <buf)

MISSING = "no such file or directory"

fun unreadable(path: ?String, e: ?error) -> Loaded
  warn(String("loc: cannot read ", lossy(path), ": ", reason(e)))
  .unreadable(bytes: size_on_disk(path))

obj Head
  bytes: String
  size: Int
  whole: Bool  # `bytes` holds the whole file

# A file gone since the walk found it fails as `not_found`.
fun read_head(path: ?String, device: Bool) -> Head!
  info = file.stat(path)! ?? return file.FileError.not_found
  if not device and info.size <= SMALL
    got = file.read(path)!
    buf = <got ?? return file.FileError.not_found
    return Head(bytes: <buf, size: info.size, whole: true)
  f = file.open(path)! ?? return file.FileError.not_found
  buf = String()
  while buf.len < NUL_WINDOW
    want = NUL_WINDOW - buf.len
    break if (!f).read(!buf, want)! == 0
  Head(bytes: <buf, size: info.size, whole: false)

fun read_whole(path: ?String, device: Bool) -> String!
  if not device
    got = file.read(path)!
    return <got ?? return file.FileError.not_found
  info = file.stat(path)! ?? return file.FileError.not_found
  f = file.open(path)! ?? return file.FileError.not_found
  buf = String()
  while buf.len < info.size
    want = info.size - buf.len
    want = NUL_WINDOW if want > NUL_WINDOW
    break if (!f).read(!buf, want)! == 0
  buf

fun size_on_disk(path: ?String) -> Int
  info = (file.stat(path) catch none) ?? return 0
  info.size

fun has_nul(buf: ?String) -> Bool
  window = buf[..NUL_WINDOW] if buf.len > NUL_WINDOW else buf
  text.find_any["\x00"](window, 0) != none

fun claims(table: ?Table, ci: Int, buf: ?String) -> Bool
  if ?table.langs[ci].claim as c
    return c.test(first_line(buf))
  false

fun interpreter_lang(table: ?Table, head: ?String) -> Int?
  table.by_interpreter(shebang(head)?)

# The first word's last component, or the first word after env that is no option.
fun shebang(head: ?String) -> (?String)? from head
  rest = text.strip_prefix(head, "#!")?
  stop = text.find_any["\n\r"](rest, 0) ?? rest.len
  words = Words(s: rest[..stop], at: 0)
  first = (!words).next()?
  base = first[(text.find_last(first, "/") ?? -1) + 1..]
  return base if base != "env"
  while (!words).next() as w
    return w if w[0] != '-'
  none

# Space and tab only, as Rust splits; text.words also splits at VT and FF.
obj Words
  s: ?String
  at: Int

  fun next(!@) -> (?String)? from @s
    while @at < @s.len and (@s[@at] == ' ' or @s[@at] == "\t")
      @at += 1
    return none if @at == @s.len
    start = @at
    while @at < @s.len and @s[@at] != ' ' and @s[@at] != "\t"
      @at += 1
    @s[start..@at]

# Cut at NUL_WINDOW, so the head and the whole file give the same line.
fun first_line(buf: ?String) -> ?String from buf
  cut = buf[..NUL_WINDOW] if buf.len > NUL_WINDOW else buf
  cut = text.strip_prefix(cut, BOM) ?? cut
  cut[..text.find_any["\n"](cut, 0) ?? cut.len]

fun base_name(path: ?String) -> ?String from path
  path[(text.find_last(path, "/") ?? -1) + 1..]

# From the last . that is not the first byte.
fun extension(name: ?String) -> (?String)? from name
  dot = text.find_last(name, ".") ?? return none
  return none if dot == 0
  name[dot..]

fun label_of(name: ?String, ext: (?String)?, lower: ?String) -> String
  lossy(lower if ext != none else name)

pub fun reason(e: ?error) -> String
  match e
    file.FileError.not_found => String(MISSING)
    file.FileError.denied => String("permission denied")
    file.FileError.is_directory => String("is a directory")
    file.FileError.not_directory => String("not a directory")
    _ => String(e)

# ---- The walk --------------------------------------------------------------

obj Patterns
  exclude: IgnoreFile?
  only: IgnoreFile?

# With several roots, a file is sent once: links are never followed, so a
# file has one key below its resolved root. Roots that may share a file
# share one walker and its keys; any other root gets `most` walker tasks.
obj Sender
  jobs: *Chan[Job]
  asks: *Chan[Int]
  asked: *Cell[Int]    # counters asked for, by every sender
  table: ?Table
  filter: ?LangFilter
  walkers: *Cell[Int]  # walker tasks listing, not waiting for their own
  most: Int = 1
  seen: Set[String]? = none
  root: String = String()
  resolved: String = String()

  sub send(!@, job: Job)!
    if !@seen as seen
      return if not (!seen).add(dedup_key(@root, @resolved, job.path))
    !@jobs.send(<job)!
    if @asked.get() < COUNTERS and (!@asked).add(1) <= COUNTERS
      !@asks.send(1)!

  # Whether a directory gets a walker task of its own.
  fun spawns(!@) -> Bool
    return true if (!@walkers).add(1) <= @most
    _ = (!@walkers).sub(1)
    false

  fun kid(?@) -> Sender
    Sender(jobs: +@jobs, asks: +@asks, asked: +@asked, table: @table, filter: @filter, walkers: +@walkers, most: @most)

  # A walker waiting for its own tasks leaves its turn to another.
  sub rests(!@)
    _ = (!@walkers).sub(1)

  sub resumes(!@)
    _ = (!@walkers).add(1)

# Leading / dropped, as Rust's component-wise paths compare.
fun dedup_key(root: ?String, resolved: ?String, path: ?String) -> String
  return String(resolved) if path.len == root.len
  rest = path[root.len..]
  while rest.len > 0 and rest[0] == '/'
    rest = rest[1..]
  String(resolved, "/", rest)

sub walk_roots(table: ?Table, filter: ?LangFilter, opts: ?Options, checked: List[Root], jobs: *Chan[Job], asks: *Chan[Int])!
  defer !jobs.close()
  defer !asks.close()
  asked = *Cell(0)
  resolved: List[String?] = List()
  if opts.roots.len > 1
    for root in opts.roots
      !resolved.push(file.realpath(root) catch none)
  shared = Sender(jobs: +jobs, asks: +asks, asked: +asked, table: table, filter: filter, walkers: *Cell(1), seen: Set[String]())
  sharing = overlapping(resolved)
  for c, i in <checked
    root = ?opts.roots[i]
    if sharing.len > 0 and sharing[i]
      shared.root = +root
      shared.resolved = String(root)
      if ?resolved[i] as r
        shared.resolved = +r
      walk(root, opts, <c, !shared)!
    else
      alone = Sender(jobs: +jobs, asks: +asks, asked: +asked, table: table, filter: filter, walkers: *Cell(1), most: WALKERS)
      walk(root, opts, <c, !alone)!

# For each root, whether it may share a file with another: one resolved
# path holds the other, or a root did not resolve. Sets keep it linear.
fun overlapping(resolved: ?List[String?]) -> List[Bool]
  flags: List[Bool] = List()
  all = Set[String]()
  twice = Set[String]()
  above = Set[String]()  # each strict ancestor of a resolved root
  unresolved = false
  for i in 0..resolved.len
    if ?resolved[i] as p
      if not (!all).add(String(p))
        _ = (!twice).add(String(p))
      for k in 0..p.len - 1
        _ = (!above).add(String(p[..k] if k > 0 else "/")) if p[k] == '/'
    else
      unresolved = true
  for i in 0..resolved.len
    shares = unresolved
    if not shares and ?resolved[i] as p
      shares = twice.has(p) or above.has(p)
      for k in 0..p.len - 1
        shares = true if p[k] == '/' and all.has(p[..k] if k > 0 else "/")
    !flags.push(shares)
  flags

sub walk(root: ?String, opts: ?Options, c: Root, sender: !Sender)!
  if c.kind != .directory
    !sender.send(Job(path: String(root), device: c.kind != .file))!
    return
  stack: List[IgnoreFile] = List()
  rel = String()
  if not opts.no_ignore
    stack, rel = ancestors(root)
  pats = Patterns(
    exclude: pattern_file(opts.excludes, offset_below(rel)) if opts.excludes.len > 0 else none,
    only: pattern_file(opts.only, offset_below(rel)) if opts.only.len > 0 else none,
  )
  cx = Walk(pats: ?pats, no_ignore: opts.no_ignore)
  above = Ignores(files: ?stack)
  walk_dir(root, rel, above, pats.only == none, cx, !sender, <c.entries)!

# What every directory of one walk reads.
obj Walk
  pats: ?Patterns
  no_ignore: Bool

# `rel` is below the ignore files' base; `selected` is whether --only chose
# this directory or one above it. A subdirectory's task reads this frame's
# ignore files in place, so the frame waits for its tasks before it ends.
sub walk_dir(dir: ?String, rel: ?String, ignores: ?Ignores, selected: Bool, cx: ?Walk, sender: !Sender, listed: List[file.Entry]? = none)!
  entries = <listed ?? list_dir(dir) ?? return
  mine: List[IgnoreFile] = List()
  # Only a listed .gitignore is read, saving a call in every other directory.
  if not cx.no_ignore and lists_gitignore(entries) and read_ignore(dir, offset_below(rel)) as f
    !mine.push(<f)
  here = Ignores(files: ?mine, up: ignores)
  kids = Tasks[Void!]()
  spawned = false
  for e in ?entries
    continue if e.name == ".git" or e.link or e.kind == .other
    is_dir = e.kind == .directory
    child_rel = String(rel, "/", e.name) if rel.len > 0 else +e.name
    continue if ignored(cx.pats.exclude, here, child_rel, e.name, is_dir)
    chosen = selected
    if not chosen and ?cx.pats.only as only
      chosen = selects(only, child_rel, e.name, is_dir)
    if is_dir and (!sender).spawns()
      !kids.add(walk_task(join(dir, ?e.name), <child_rel, ?here, chosen, cx, sender.kid())&)
      spawned = true
    else if is_dir
      walk_dir(join(dir, e.name), child_rel, here, chosen, cx, !sender)!
    else if chosen and not (sender.filter.by_name and dropped_by_name(sender.table, sender.filter, e.name))
      !sender.send(Job(path: join(dir, e.name)))!
  return if not spawned
  !sender.rests()
  (>kids)!
  !sender.resumes()

sub walk_task(dir: String, rel: String, ignores: ?Ignores, selected: Bool, cx: ?Walk, sender: Sender)!
  s = <sender
  walk_dir(dir, rel, ignores, selected, cx, !s)!
  !s.rests()

fun list_dir(dir: ?String) -> List[file.Entry]?
  got = file.read_dir(dir) catch |e|
    warn(String("loc: cannot read ", lossy(dir), ": ", reason(e)))
    return none
  if got == none
    warn(String("loc: cannot read ", lossy(dir), ": ", MISSING))
  got

fun lists_gitignore(entries: ?List[file.Entry]) -> Bool
  for e in entries
    return true if e.name == ".gitignore"
  false

fun join(dir: ?String, name: ?String) -> String
  return String(dir, name) if text.ends_with(dir, "/")
  String(dir, "/", name)

# What `check_root` found of a PATH, so the walk asks no second time.
pub obj Root
  kind: file.Kind
  entries: List[file.Entry]? = none  # a directory's listing

# A PATH that cannot be read exits 2 here, not as a skipped file later.
pub fun check_root(root: ?String) -> Root!
  info = file.stat(root)! ?? return file.FileError.not_found
  if info.kind == .directory
    entries = file.read_dir(root)! ?? return file.FileError.not_found
    return Root(kind: info.kind, entries: <entries)
  _ = file.open(root)! ?? return file.FileError.not_found
  Root(kind: info.kind)
