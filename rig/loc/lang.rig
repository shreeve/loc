# The language table from SPEC.md and the byte tables derived from it.

use std.sort

# The openers of code inside a string, each closed by its matching `}`.
DOLLAR_OPENERS = ["${"]
HASH_OPENERS = ["#{"]
RIP_OPENERS = ["#{", "${"]
PHP_OPENERS = ["{$"]

enum Interp
  dollar
  hash
  rip
  php

fun openers(i: Interp) -> []Static
  match i
    .dollar => ?DOLLAR_OPENERS[..]
    .hash => ?HASH_OPENERS[..]
    .rip => ?RIP_OPENERS[..]
    .php => ?PHP_OPENERS[..]

# One way a language writes a string literal; char literals are a kind too.
# `stop` holds the bytes that end the fast skip inside the string: the
# closer's first byte, backslash, and each interpolation opener's first byte.
obj StrKind
  open: Static
  close: Static
  escape: Bool
  multiline: Bool
  interp: Interp? = none
  stop: [256]Bool = [256 of false]

fun kind(open: Static, close: Static, escape: Bool, multiline: Bool, interp: Interp? = none) -> StrKind
  k = StrKind(open: open, close: close, escape: escape, multiline: multiline, interp: interp)
  k.stop[close[0]] = true
  k.stop[BACKSLASH] = true
  if interp as i
    for o in openers(i)
      k.stop[o[0]] = true
  k

fun dq() -> StrKind
  kind("\"", "\"", true, false)

fun sq() -> StrKind
  kind("'", "'", true, false)

fun tick() -> StrKind
  kind("`", "`", true, true, .dollar)

# Words after which a / opens a regex literal.
JS_REGEX_WORDS = ["return", "typeof", "instanceof", "in", "of", "new", "delete", "void", "throw", "case", "do", "else", "yield", "await"]
RIP_REGEX_WORDS = [
  "return", "typeof", "instanceof", "in", "of", "new", "delete", "void", "throw", "case", "do", "else", "yield", "await",
  "if", "unless", "when", "while", "until", "and", "or", "not", "is", "isnt", "then",
]
RUBY_REGEX_WORDS = ["if", "unless", "while", "until", "and", "or", "not", "then", "else", "elsif", "when", "case", "return", "yield", "raise"]

enum Chars
  always  # every ' outside a string or comment opens a char literal
  rust    # ' opens one only before \ or when the byte after next is ': lifetimes have no closer

# How a language spells a heredoc opener after <<.
enum Heredoc
  shell   # optional -, then spaces, then a word that may be quoted or start with \
  ruby    # optional - or ~, then a word that may be quoted, with no space anywhere
  php     # a third <, spaces, then a word that may be quoted; the terminator may be indented and followed by ; or ,

# An embedded language: the body between the delimiters is scanned by the language named.
enum Region
  tag(name: Static, lang: Static)                     # <name …> opens after its >, </name> closes
  between(open: Static, close: Static, lang: Static)  # open compared without regard to ASCII case

# Extensions another language owns, taken for this one when test accepts a file's first line.
obj Claim
  extensions: List[Static]
  test: fun(?String) -> Bool

# A language as the scanner sees it. Empty lists, `none`, and false mean the syntax is absent.
obj Lang
  name: Static
  extensions: List[Static] = List()   # lower-case, dot included
  names: List[Static] = List()        # whole file names recognized without an extension
  shebangs: List[Static] = List()     # interpreters whose #! line recognizes an extensionless file
  claim: Claim? = none
  line: List[Static] = List()         # line-comment openers; none shares a prefix with another
  hash_attribute: Bool = false        # `#[` begins an attribute, not a comment (PHP)
  block_open: Static = ""
  block_close: Static = ""
  nests: Bool = false                 # block comments nest (Rust); otherwise the first closer ends one (Go)
  block_at_line_start: Bool = false   # a block comment opens only as the first non-whitespace of a line (Rip)
  strings: List[StrKind] = List()
  chars: Chars? = none
  regex: List[Static]? = none         # /…/ literals by the previous-byte-or-word rule, with the words
  zig_line_string: Bool = false       # \\ to end of line
  rust_raw: Bool = false              # r#*"…"#*, optional b prefix
  heredoc: Heredoc? = none
  regions: List[Region] = List()
  region_langs: List[Int] = List()    # the language index of each region, from `prepare`
  color: [3]U8 = [3 of 0]
  starts: [256]Bool = [256 of false]  # bytes that can begin a token in normal state; any other byte is plain code

  # Whether --languages lists it: an entry no file can reach, such as an
  # embedded-only language, is not a name the user can give.
  fun listed(?@) -> Bool
    @extensions.len > 0 or @names.len > 0 or @shebangs.len > 0 or @claim != none

# The table and its lookups. Keys are lower-case where the lookup ignores
# case, and `String` so that a lookup takes any `?String`.
pub obj Table
  langs: List[Lang]
  char: StrKind                       # the char literal of Go, Rust, Zig, and their kin
  by_ext: Map[String, Int]
  by_claim: Map[String, Int]
  by_name: Map[String, Int]
  by_shebang: Map[String, Int]
  binary_exts: Set[String]
  text_exts: Set[String]

  # Language index by extension, dot included, already lower-cased.
  fun by_extension(?@, lower: ?String) -> Int?
    @by_ext.get(lower) ?? none

  # The language that may take a file with this extension from its owner.
  fun claimant(?@, lower: ?String) -> Int?
    @by_claim.get(lower) ?? none

  # Language index by whole file name, compared exactly.
  fun by_file_name(?@, name: ?String) -> Int?
    @by_name.get(name) ?? none

  # Language index by the interpreter of a #! line, compared exactly.
  fun by_interpreter(?@, interpreter: ?String) -> Int?
    @by_shebang.get(interpreter) ?? none

  # Language index by the name --languages prints, compared without regard to ASCII case.
  pub fun by_language(?@, name: ?String) -> Int?
    for l, i in ?@langs
      return i if l.listed() and same_ignoring_case(l.name, name)
    none

  pub fun count(?@) -> Int
    @langs.len

fun same_ignoring_case(a: ?String, b: ?String) -> Bool
  return false if a.len != b.len
  for i in 0..a.len
    return false if to_lower(a[i]) != to_lower(b[i])
  true

# `s` lower-cased in ASCII, as every extension is compared.
fun ascii_lower(s: ?String) -> String
  out = String()
  !out.reserve(s.len)
  for b in s
    !out.push(to_lower(b))
  out

fun c_family(name: Static, extensions: List[Static], color: [3]U8) -> Lang
  Lang(
    name: name,
    extensions: <extensions,
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([dq()]),
    chars: .always,
    color: color,
  )

fun js_family(name: Static, extensions: List[Static], color: [3]U8) -> Lang
  Lang(
    name: name,
    extensions: <extensions,
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([tick(), dq(), sq()]),
    regex: List(JS_REGEX_WORDS),
    color: color,
  )

# Markup with <!-- --> comments, JavaScript inside <script> and CSS inside
# <style>, and no string syntax of its own.
fun markup(name: Static, extensions: List[Static], color: [3]U8) -> Lang
  Lang(
    name: name,
    extensions: <extensions,
    block_open: "<!--",
    block_close: "-->",
    regions: List([Region.tag(name: "script", lang: "JavaScript"), Region.tag(name: "style", lang: "CSS")]),
    color: color,
  )

# Colors are GitHub linguist's, except Rip and Rig, which linguist does not
# list, and MUMPS, which it lists as M without a color.
pub fun languages() -> Table
  langs: List[Lang] = List()
  !langs.push(js_family("TypeScript", List([".ts", ".tsx", ".mts", ".cts"]), [0x31, 0x78, 0xc6]))
  js = js_family("JavaScript", List([".js", ".mjs", ".cjs", ".jsx"]), [0xf1, 0xe0, 0x5a])
  js.shebangs = List(["node", "nodejs", "bun", "deno"])
  !langs.push(<js)
  !langs.push(Lang(
    name: "Go",
    extensions: List([".go"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([kind("`", "`", false, true), dq()]),
    chars: .always,
    color: [0x00, 0xad, 0xd8],
  ))
  !langs.push(Lang(
    name: "Rust",
    extensions: List([".rs"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([kind("\"", "\"", true, true)]),
    chars: .rust,
    rust_raw: true,
    color: [0xde, 0xa5, 0x84],
  ))
  !langs.push(Lang(
    name: "Zig",
    extensions: List([".zig"]),
    line: List(["//"]),
    strings: List([dq()]),
    chars: .always,
    zig_line_string: true,
    color: [0xec, 0x91, 0x5c],
  ))
  !langs.push(Lang(
    name: "Python",
    extensions: List([".py", ".pyi"]),
    shebangs: List(["python", "python2", "python3"]),
    line: List(["#"]),
    strings: List([kind("\"\"\"", "\"\"\"", true, true), kind("'''", "'''", true, true), dq(), sq()]),
    color: [0x35, 0x72, 0xa5],
  ))
  !langs.push(Lang(
    name: "JSON",
    extensions: List([".json", ".jsonc"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([dq()]),
    color: [0x29, 0x29, 0x29],
  ))
  !langs.push(Lang(name: "Markdown", extensions: List([".md", ".markdown"]), color: [0x08, 0x3f, 0xa1]))
  !langs.push(c_family("C", List([".c", ".h"]), [0x55, 0x55, 0x55]))
  !langs.push(c_family("C++", List([".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"]), [0xf3, 0x4b, 0x7d]))
  !langs.push(Lang(
    name: "Rip",
    extensions: List([".rip"]),
    line: List(["#"]),
    block_open: "###",
    block_close: "###",
    block_at_line_start: true,
    strings: List([
      kind("\"\"\"", "\"\"\"", true, true, .rip),
      kind("'''", "'''", true, true),
      kind("///", "///", true, true, .hash),
      kind("\"", "\"", true, false, .rip),
      sq(),
    ]),
    regex: List(RIP_REGEX_WORDS),
    color: [0xab, 0x23, 0x17],
  ))
  !langs.push(Lang(
    name: "Rig",
    extensions: List([".rig"]),
    line: List(["#"]),
    strings: List([dq(), kind("'", "'", false, false)]),
    color: [0x4b, 0x65, 0x84],
  ))
  !langs.push(Lang(
    name: "CSS",
    extensions: List([".css"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([dq(), sq()]),
    color: [0x66, 0x33, 0x99],
  ))
  !langs.push(Lang(
    name: "YAML",
    extensions: List([".yml", ".yaml"]),
    line: List(["#"]),
    strings: List([dq(), kind("'", "'", false, false)]),
    color: [0xcb, 0x17, 0x1e],
  ))
  !langs.push(Lang(
    name: "TOML",
    extensions: List([".toml"]),
    line: List(["#"]),
    strings: List([kind("\"\"\"", "\"\"\"", true, true), kind("'''", "'''", false, true), dq(), kind("'", "'", false, false)]),
    color: [0x9c, 0x42, 0x21],
  ))
  !langs.push(Lang(
    name: "SQL",
    extensions: List([".sql"]),
    line: List(["--"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([kind("'", "'", false, true), kind("\"", "\"", false, false)]),
    color: [0xe3, 0x8c, 0x00],
  ))
  !langs.push(Lang(
    name: "Dart",
    extensions: List([".dart"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([
      kind("\"\"\"", "\"\"\"", true, true, .dollar),
      kind("'''", "'''", true, true, .dollar),
      kind("\"", "\"", true, false, .dollar),
      kind("'", "'", true, false, .dollar),
    ]),
    color: [0x00, 0xb4, 0xab],
  ))
  !langs.push(Lang(
    name: "CoffeeScript",
    extensions: List([".coffee"]),
    shebangs: List(["coffee"]),
    line: List(["#"]),
    block_open: "###",
    block_close: "###",
    block_at_line_start: true,
    strings: List([
      kind("\"\"\"", "\"\"\"", true, true, .hash),
      kind("'''", "'''", true, true),
      kind("///", "///", true, true, .hash),
      kind("```", "```", false, true),
      kind("\"", "\"", true, false, .hash),
      sq(),
      kind("`", "`", false, false),
    ]),
    regex: List(RIP_REGEX_WORDS),
    color: [0x24, 0x47, 0x76],
  ))
  !langs.push(Lang(
    name: "Ruby",
    extensions: List([".rb", ".rake", ".gemspec"]),
    names: List(["Gemfile", "Rakefile"]),
    shebangs: List(["ruby"]),
    line: List(["#"]),
    block_open: "=begin",
    block_close: "=end",
    block_at_line_start: true,
    strings: List([kind("\"", "\"", true, true, .hash), kind("'", "'", true, true), kind("`", "`", true, false)]),
    regex: List(RUBY_REGEX_WORDS),
    heredoc: .ruby,
    color: [0x70, 0x15, 0x16],
  ))
  !langs.push(Lang(
    name: "Shell",
    extensions: List([".sh", ".bash", ".zsh", ".ksh"]),
    names: List([".bashrc", ".bash_profile", ".profile", ".zshrc"]),
    shebangs: List(["sh", "bash", "zsh", "ksh", "dash"]),
    line: List(["#"]),
    strings: List([kind("\"", "\"", true, true), kind("'", "'", false, true)]),
    heredoc: .shell,
    color: [0x89, 0xe0, 0x51],
  ))
  !langs.push(markup("HTML", List([".html", ".htm"]), [0xe3, 0x4c, 0x26]))
  !langs.push(markup("Vue", List([".vue"]), [0x41, 0xb8, 0x83]))
  !langs.push(markup("Svelte", List([".svelte"]), [0xff, 0x3e, 0x00]))
  !langs.push(Lang(
    name: "Java",
    extensions: List([".java"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([kind("\"\"\"", "\"\"\"", true, true), dq()]),
    chars: .always,
    color: [0xb0, 0x72, 0x19],
  ))
  !langs.push(Lang(
    name: "Kotlin",
    extensions: List([".kt", ".kts"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([kind("\"\"\"", "\"\"\"", false, true, .dollar), kind("\"", "\"", true, false, .dollar)]),
    chars: .always,
    color: [0xa9, 0x7b, 0xff],
  ))
  !langs.push(Lang(
    name: "Scala",
    extensions: List([".scala", ".sc", ".sbt"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([kind("\"\"\"", "\"\"\"", false, true, .dollar), kind("\"", "\"", true, false, .dollar)]),
    chars: .rust,
    color: [0xc2, 0x2d, 0x40],
  ))
  !langs.push(Lang(
    name: "Groovy",
    extensions: List([".groovy", ".gvy", ".gradle"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([
      kind("\"\"\"", "\"\"\"", true, true, .dollar),
      kind("'''", "'''", true, true),
      kind("\"", "\"", true, false, .dollar),
      sq(),
    ]),
    color: [0x42, 0x98, 0xb8],
  ))
  !langs.push(Lang(
    name: "Swift",
    extensions: List([".swift"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([kind("\"\"\"", "\"\"\"", true, true), dq()]),
    color: [0xf0, 0x51, 0x38],
  ))
  !langs.push(c_family("Objective-C", List([".m", ".mm"]), [0x43, 0x8e, 0xff]))
  !langs.push(Lang(
    name: "MUMPS",
    extensions: List([".mumps"]),
    claim: Claim(extensions: List([".m"]), test: mumps_routine),
    line: List([";"]),
    strings: List([kind("\"", "\"", false, false)]),
    color: [0x6b, 0x8e, 0x23],
  ))
  !langs.push(css_family("SCSS", List([".scss"]), [0xc6, 0x53, 0x8c]))
  !langs.push(css_family("Sass", List([".sass"]), [0xa5, 0x3b, 0x70]))
  !langs.push(css_family("Less", List([".less"]), [0x1d, 0x36, 0x5d]))
  php = markup("PHP", List([".php", ".phtml"]), [0x4f, 0x5d, 0x95])
  php.shebangs = List(["php"])
  php.regions = List([
    Region.tag(name: "script", lang: "JavaScript"),
    Region.tag(name: "style", lang: "CSS"),
    Region.between(open: "<?php", close: "?>", lang: "PHP code"),
    Region.between(open: "<?=", close: "?>", lang: "PHP code"),
  ])
  !langs.push(<php)
  # The rules inside PHP's <?php … ?> regions; never recognized by
  # extension, so never a row of its own.
  !langs.push(Lang(
    name: "PHP code",
    line: List(["//", "#"]),
    hash_attribute: true,
    block_open: "/*",
    block_close: "*/",
    strings: List([kind("\"", "\"", true, true, .php), kind("'", "'", true, true), kind("`", "`", true, false)]),
    heredoc: .php,
  ))
  !langs.push(Lang(
    name: "C#",
    extensions: List([".cs"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([
      kind("\"\"\"", "\"\"\"", false, true),
      kind("@$\"", "\"", false, true),
      kind("$@\"", "\"", false, true),
      kind("@\"", "\"", false, true),
      dq(),
    ]),
    chars: .always,
    color: [0x73, 0x55, 0xdd],
  ))
  !langs.push(Lang(
    name: "XML",
    extensions: List([".xml", ".xsd", ".xsl", ".xslt"]),
    block_open: "<!--",
    block_close: "-->",
    color: [0x00, 0x60, 0xac],
  ))
  prepare(!langs)
  indexed(<langs)

fun css_family(name: Static, extensions: List[Static], color: [3]U8) -> Lang
  Lang(
    name: name,
    extensions: <extensions,
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    strings: List([dq(), sq()]),
    color: color,
  )

# A MUMPS routine's first line: a `;` comment from column zero, as
# YottaDB's license banners are; or an optional label, `%` or a letter and
# then letters and digits, with an optional formal list; then spaces or
# tabs; then the `;` of a comment.
fun mumps_routine(first: ?String) -> Bool
  return true if first.len > 0 and first[0] == SEMICOLON
  i = 0
  if first.len > 0 and (first[0] == PERCENT or is_letter(first[0]))
    i = 1
    while i < first.len and (is_letter(first[i]) or is_digit(first[i]))
      i += 1
    if i < first.len and first[i] == OPEN_PAREN
      while i < first.len and first[i] != CLOSE_PAREN
        i += 1
      return false if i == first.len
      i += 1
  label_end = i
  while i < first.len and (first[i] == SPACE or first[i] == TAB)
    i += 1
  i > label_end and i < first.len and first[i] == SEMICOLON

# Extensions that are never text and common enough to be numerous in an
# ordinary tree: a file with one is binary by its name alone, so it is never
# opened. Anything rarer is left to the NUL check, which is exact.
pub BINARY_EXTENSIONS = [
  ".png", ".jpg", ".jpeg", ".gif", ".ico", ".webp", ".ttf", ".otf", ".woff", ".woff2", ".zip",
  ".gz", ".tgz", ".bz2", ".xz", ".zst", ".7z", ".jar", ".mp3", ".mp4", ".mov", ".wav", ".webm",
  ".pyc", ".o", ".a", ".so", ".dylib", ".dll", ".exe", ".class", ".wasm", ".rlib", ".rmeta",
  ".pdf",
]

# Extensions that are always text and common enough to be numerous in an
# ordinary tree, the same test as above and with the same trade: a file with
# one is skipped text by its name alone, sized without being opened.
pub TEXT_EXTENSIONS = [".txt", ".rst", ".dts", ".dtsi", ".diff", ".s", ".map", ".svg", ".snap", ".lock"]

# The scanner only ever tests a byte against these derived tables. Strings
# go longest opener first, so `"""` is tried before `"`; the sort is
# stable, so equal lengths keep table order.
sub prepare(langs: !List[Lang])
  names: List[Static] = List()
  for l in langs
    !names.push(l.name)
  for l in !langs
    sort.sort_by(!l.strings, |a, b| a.open.len > b.open.len)
    for r in l.regions
      want = match r
        .tag(_, lang) => lang
        .between(_, _, lang) => lang
      for name, j in names
        if name == want
          !l.region_langs.push(j)
    for b in [SPACE, TAB, CR, FORM_FEED, VERTICAL_TAB, BACKSLASH]
      l.starts[b] = true
    for o in l.line
      l.starts[o[0]] = true
    if l.block_open.len > 0
      l.starts[l.block_open[0]] = true
    for k in l.strings
      l.starts[k.open[0]] = true
      if k.interp != none
        l.starts[OPEN_BRACE] = true
        l.starts[CLOSE_BRACE] = true
    if l.chars != none
      l.starts[APOSTROPHE] = true
    if l.regex != none
      l.starts[SLASH] = true
    if l.rust_raw
      l.starts[LOWER_R] = true
      l.starts[LOWER_B] = true
    if l.heredoc != none or l.regions.len > 0
      l.starts[LESS_THAN] = true

fun indexed(langs: List[Lang]) -> Table
  t = Table(
    langs: <langs,
    char: kind("'", "'", true, false),
    by_ext: Map[String, Int](),
    by_claim: Map[String, Int](),
    by_name: Map[String, Int](),
    by_shebang: Map[String, Int](),
    binary_exts: Set[String](),
    text_exts: Set[String](),
  )
  for l, i in t.langs
    for e in l.extensions
      !t.by_ext.put(String(e), i)
    for n in l.names
      !t.by_name.put(String(n), i)
    for s in l.shebangs
      !t.by_shebang.put(String(s), i)
    if l.claim as c
      for e in c.extensions
        !t.by_claim.put(String(e), i)
  for e in BINARY_EXTENSIONS
    _ = (!t.binary_exts).add(String(e))
  for e in TEXT_EXTENSIONS
    _ = (!t.text_exts).add(String(e))
  t
