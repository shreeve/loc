  !langs.push(c_family("C", List([".c", ".h"]), [0x55, 0x55, 0x55]))
  !langs.push(c_family("C++", List([".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"]), [0xf3, 0x4b, 0x7d]))
