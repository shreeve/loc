    color: [0x00, 0xad, 0xd8],
  ))
  !langs.push(Lang(
    name: "Rust",
    extensions: List([".rs"]),
    line: List(["//"]),
    block_open: "/*",
    block_close: "*/",
    nests: true,
    strings: List([kind("\"", "\"", true, true)]),
    chars: .rust,
    rust_raw: true,
    color: [0xde, 0xa5, 0x84],
  ))
  !langs.push(Lang(
    name: "Zig",
    extensions: List([".zig"]),
    line: List(["//"]),
    strings: List([dq()]),
    chars: .always,
    zig_line_string: true,
