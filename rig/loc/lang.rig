  !php.regions.push(Region.between(open: "<?=", close: "?>", lang: "PHP code"))
  !langs.push(<php)
  # The rules inside <?php … ?>, never a row of its own.
  !langs.push(Lang(
    name: "PHP code",
    line: List(["//", "#"]),
    hash_attribute: true,
    block_open: "/*",
    block_close: "*/",
