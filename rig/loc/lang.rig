  !langs.push(Lang(
    name: "XML",
    extensions: List([".xml", ".xsd", ".xsl", ".xslt"]),
    block_open: "<!--",
    block_close: "-->",
    color: [0x00, 0x60, 0xac],
  ))
  prepare(!langs)
  indexed(<langs)

# A MUMPS routine's first line: `;` at column zero, or an optional label
# and formal list, then spaces or tabs, then `;`.
fun mumps_routine(first: ?String) -> Bool
  return true if first.len > 0 and first[0] == ';'
  i = 0
  if first.len > 0 and (first[0] == '%' or text.is_alpha(first[0]))
    i = 1
    while i < first.len and (text.is_alpha(first[i]) or text.is_digit(first[i]))
      i += 1
    if i < first.len and first[i] == '('
      while i < first.len and first[i] != ')'
        i += 1
      return false if i == first.len
      i += 1
  label_end = i
  while i < first.len and (first[i] == ' ' or first[i] == "\t")
    i += 1
  i > label_end and i < first.len and first[i] == ';'

# Common enough to decide by name alone, so the file is never opened.
pub BINARY_EXTENSIONS = [
  ".png", ".jpg", ".jpeg", ".gif", ".ico", ".webp", ".ttf", ".otf", ".woff", ".woff2", ".zip",
  ".gz", ".tgz", ".bz2", ".xz", ".zst", ".7z", ".jar", ".mp3", ".mp4", ".mov", ".wav", ".webm",
  ".pyc", ".o", ".a", ".so", ".dylib", ".dll", ".exe", ".class", ".wasm", ".rlib", ".rmeta",
  ".pdf",
]

pub TEXT_EXTENSIONS = [".txt", ".rst", ".dts", ".dtsi", ".diff", ".s", ".map", ".svg", ".snap", ".lock"]

# Strings go longest opener first, so `"""` is tried before `"`; the sort is
# stable, so equal lengths keep table order.
sub prepare(langs: !List[Lang])
  names: List[Static] = List()
  for l in langs
    !names.push(l.name)
  for l in !langs
    sort.sort_by(!l.strings, |a, b| a.open.len > b.open.len)
    for r in l.regions
      want = match r
        .tag(_, lang) => lang
        .between(_, _, lang) => lang
      !l.region_langs.push(slices.index_of(names, want) ?? panic("no language named", want))
    l.starts = WHITESPACE
    l.starts[U8('\')] = true
    for o in l.line
      l.starts[o[0]] = true
    if l.block_open.len > 0
      l.starts[l.block_open[0]] = true
    for k in l.strings
      l.starts[k.open[0]] = true
      if k.interp != none
        l.starts[U8('{')] = true
        l.starts[U8('}')] = true
    if l.chars != none
      l.starts[U8("'")] = true
    if l.regex != none
      l.starts[U8('/')] = true
    if l.rust_raw
      l.starts[U8('r')] = true
      l.starts[U8('b')] = true
    if l.heredoc != none or l.regions.len > 0
      l.starts[U8('<')] = true
  for i in 0..langs.len
    for ri in 0..langs[i].regions.len
      stops = langs[langs[i].region_langs[ri]].starts
      stops[closer_first(langs[i].regions[ri])] = true
      !langs[i].region_stops.push(stops)

fun indexed(langs: List[Lang]) -> Table
  t = Table(langs: <langs, char: sq())
  for l, i in t.langs
    for e in l.extensions
      !t.by_ext.put(String(e), i)
    for n in l.names
      !t.by_name.put(String(n), i)
    for s in l.shebangs
      !t.by_shebang.put(String(s), i)
    if l.claim as c
      for e in c.extensions
        !t.by_claim.put(String(e), i)
  for e in BINARY_EXTENSIONS
    _ = (!t.binary_exts).add(String(e))
  for e in TEXT_EXTENSIONS
    _ = (!t.text_exts).add(String(e))
  t

fun closer_first(r: ?Region) -> U8
  match r
    .tag(_, _) => '<'
    .between(_, close, _) => close[0]
