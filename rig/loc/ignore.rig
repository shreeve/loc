# .gitignore matching, SPEC.md Ignore rules. A pattern is compiled once into
# a small program of steps; matching is a backtracking walk over the path's
# bytes, which is what git's fnmatch does without a regex engine.

use std.file
use std.os
use std.text

enum Step
  byte(b: U8)                    # one literal byte
  any                            # * : zero or more bytes other than /
  one                            # ? : one byte other than /
  class(set: Int, inside: Bool)  # […] : one byte other than /, in the pattern's `sets[set]` (inside) or outside it
  any_dirs                       # a leading **/ or a middle /**/ : nothing, or any run of bytes ending in /
  rest                           # a trailing /** : anything at all

obj Pattern
  negate: Bool
  dir_only: Bool
  anchored: Bool
  steps: List[Step]
  sets: List[[256]Bool]

# An ignore file and how far below the base directory it sits, as a byte
# offset into the relative path of the entries it applies to:
# rel[offset..] is an entry's path relative to the file's own directory.
obj IgnoreFile
  offset: Int
  patterns: List[Pattern]

fun compile_pattern(text_line: ?String) -> Pattern?
  negate = text_line[0] == EXCLAMATION
  glob = text_line[1..] if negate else text_line
  dir_only = glob.len > 0 and glob[glob.len - 1] == SLASH
  glob = glob[..glob.len - 1] if dir_only
  anchored = text.contains(glob, "/")
  glob = glob[1..] if anchored and glob[0] == SLASH
  return none if glob.len == 0
  steps, sets = compile_glob(glob)?
  Pattern(negate: negate, dir_only: dir_only, anchored: anchored, steps: <steps, sets: <sets)

# `none` when a [ has no closing ]: git's matcher gives up on such a line,
# so it matches nothing.
fun compile_glob(glob: ?String) -> (List[Step], List[[256]Bool])?
  steps: List[Step] = List()
  sets: List[[256]Bool] = List()
  i = 0
  if text.starts_with(glob, "**/")
    !steps.push(.any_dirs)
    i = 3
  while i < glob.len
    c = glob[i]
    after_slash = i > 0 and glob[i - 1] == SLASH
    if c == ASTERISK and after_slash and text.starts_with(glob[i..], "**/")
      !steps.push(.any_dirs)
      i += 3
    else if c == ASTERISK and after_slash and glob[i..] == "**"
      !steps.push(.rest)
      i += 2
    else if c == ASTERISK
      !steps.push(.any)
      i += 1
      i += 1 if i < glob.len and glob[i] == ASTERISK  # any other ** is *
    else if c == QUESTION
      !steps.push(.one)
      i += 1
    else if c == BACKSLASH and i + 1 < glob.len
      !steps.push(.byte(glob[i + 1]))
      i += 2
    else if c == OPEN_BRACKET
      set, inside, n = compile_class(glob[i..])?
      !steps.push(.class(set: sets.len, inside: inside))
      !sets.push(set)
      i += n
    else
      !steps.push(.byte(c))
      i += 1
  return steps, sets

# Reads a bracket set starting at glob[0] == '[': the set, whether a byte
# matches by being inside it, and the number of bytes the set took.
fun compile_class(glob: ?String) -> ([256]Bool, Bool, Int)?
  set = [256 of false]
  inside = true
  j = 1
  if j < glob.len and (glob[j] == EXCLAMATION or glob[j] == CARET)
    inside = false
    j += 1
  member = false  # whether the previous byte can start a range
  while j < glob.len
    c = glob[j]
    if c == CLOSE_BRACKET
      return set, inside, j + 1
    if c == BACKSLASH and j + 1 < glob.len
      set[glob[j + 1]] = true
      member = true
      j += 2
    else if c == MINUS and member and j + 1 < glob.len and glob[j + 1] != CLOSE_BRACKET
      for b in glob[j - 1]..=glob[j + 1]
        set[b] = true
      member = false
      j += 2
    else
      set[c] = true
      member = true
      j += 1
  none

# Whether p's steps from `at` match subject to the end of both.
fun matches(p: ?Pattern, at: Int, subject: ?String) -> Bool
  return subject.len == 0 if at == p.steps.len
  match p.steps[at]
    .byte(b) => subject.len > 0 and subject[0] == b and matches(p, at + 1, subject[1..])
    .one => subject.len > 0 and subject[0] != SLASH and matches(p, at + 1, subject[1..])
    .class(set, inside)
      subject.len > 0 and subject[0] != SLASH and p.sets[set][subject[0]] == inside and matches(p, at + 1, subject[1..])
    .any
      for k in 0..subject.len + 1
        return true if matches(p, at + 1, subject[k..])
        return false if k == subject.len or subject[k] == SLASH
      false
    .any_dirs
      return true if matches(p, at + 1, subject)
      for k in 0..subject.len
        return true if subject[k] == SLASH and matches(p, at + 1, subject[k + 1..])
      false
    .rest => true

fun parse_ignore(body: ?String, offset: Int) -> IgnoreFile
  patterns: List[Pattern] = List()
  for piece in text.split(body, "\n")
    entry = text.strip_suffix(piece, "\r") ?? piece
    continue if entry.len == 0 or entry[0] == HASH
    # trailing spaces go unless the last is escaped
    while entry.len > 0 and entry[entry.len - 1] == SPACE and not (entry.len > 1 and entry[entry.len - 2] == BACKSLASH)
      entry = entry[..entry.len - 1]
    if compile_pattern(entry) as p
      !patterns.push(<p)
  IgnoreFile(offset: offset, patterns: <patterns)

# The .gitignore of `dir`, or `none` when it has none or it cannot be read:
# the walk meets the file itself, and reports it if it is unreadable.
fun read_ignore(dir: ?String, offset: Int) -> IgnoreFile?
  body = (file.read(String(dir, "/.gitignore")) catch none)?
  parse_ignore(?body, offset)

# --exclude or --only patterns as one ignore file, each pattern a line,
# measured from the directory at offset.
fun pattern_file(lines: ?List[String], offset: Int) -> IgnoreFile
  joined = String()
  for p, i in lines
    !joined.push(LINE_FEED) if i > 0
    !joined.add(p)
  parse_ignore(?joined, offset)

# The status a file's lines give a path: that of the last matching line, or
# `none` when no line matches.
fun decides(f: ?IgnoreFile, rel: ?String, name: ?String, is_dir: Bool) -> Bool?
  i = f.patterns.len
  while i > 0
    i -= 1
    p = ?f.patterns[i]
    continue if p.dir_only and not is_dir
    subject = rel[f.offset..] if p.anchored else name
    return not p.negate if matches(p, 0, subject)
  none

# Whether a path's own last matching --only line selects it. A selected
# directory selects everything beneath it, which the walk carries down, so
# no later line can take a path inside it back.
fun selects(only: ?IgnoreFile, rel: ?String, name: ?String, is_dir: Bool) -> Bool
  decides(only, rel, name, is_dir) == true

# The --exclude patterns decide first; then the deepest file with a
# matching line, and within a file the last matching line.
fun ignored(excludes: ?IgnoreFile?, stack: ?List[IgnoreFile], rel: ?String, name: ?String, is_dir: Bool) -> Bool
  if excludes as x and decides(x, rel, name, is_dir) as status
    return status
  i = stack.len
  while i > 0
    i -= 1
    if decides(?stack[i], rel, name, is_dir) as status
      return status
  false

# Whether an entry named .git, file or directory, is in `dir`; a directory
# that cannot be read has none.
fun has_git(dir: ?String) -> Bool
  (file.stat(String(dir, "/.git")) catch none) != none

# `root` made absolute and cleaned lexically, as Rust's `absolute` and a
# walk over its components make it: split on /, empty and . components
# dropped, .. popping one but never above /.
fun absolute(root: ?String) -> String
  whole = String(root) if text.starts_with(root, "/") else String(os.cwd() catch String(), "/", root)
  kept: List[?String] = List()
  for part in text.split(?whole, "/")
    if part == ".."
      _ = (!kept).pop()
    else if part.len > 0 and part != "."
      !kept.push(part)
  out = String()
  for part in kept
    !out.add("/", part)
  return String("/") if out.len == 0
  out

# The ignore files between the nearest ancestor holding .git and root, and
# root's path relative to that ancestor. Both are empty when root holds .git
# itself or no ancestor does.
fun ancestors(root: ?String) -> (List[IgnoreFile], String)
  abs = absolute(root)
  stack: List[IgnoreFile] = List()
  return stack, String() if has_git(?abs)
  # the parents of abs, nearest first, ending with the one holding .git
  chain: List[?String] = List()
  dir = ?abs[..]
  found = false
  while parent_of(dir) as parent
    !chain.push(parent)
    if has_git(parent)
      found = true
      break
    dir = parent
  return stack, String() if not found
  base = chain[chain.len - 1]
  rel = String(below(base, ?abs))
  i = chain.len
  while i > 0
    # the base first, then each directory down to root's parent
    i -= 1
    if read_ignore(chain[i], offset_below(below(base, chain[i]))) as f
      !stack.push(<f)
  return stack, rel

# The directory holding `path`, an absolute path, or `none` at /.
fun parent_of(path: ?String) -> (?String)? from path
  return none if path == "/"
  slash = text.find_last(path, "/") ?? return none
  return path[..1] if slash == 0
  path[..slash]

# `path` relative to `base`, an ancestor of it or the same.
fun below(base: ?String, path: ?String) -> ?String from path
  return path[path.len..] if path.len == base.len
  return path[1..] if base == "/"
  path[base.len + 1..]

# Where an entry's path relative to the base continues after the directory at dir_rel.
fun offset_below(dir_rel: ?String) -> Int
  return 0 if dir_rel.len == 0 or dir_rel == "."
  dir_rel.len + 1
