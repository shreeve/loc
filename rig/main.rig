# loc in Rig. Rules: SPEC.md. Design: rig/DESIGN.md.

use loc
use std.os

extern fun isatty(fd: I32) -> I32

fun main() -> Int
  table = loc.languages()
  command = loc.parse(os.args()[1..], table) catch |e|
    warn(loc.describe(e))
    warn(loc.USAGE)
    return 1
  match <command
    .help
      say(loc.help())
      0
    .languages(no_color)
      say(loc.language_list(table, not no_color and terminal()))
      0
    .run(opts)
      checked = loc.check_roots(opts)
      readable = true
      for c, i in ?checked
        if ?c.failed as why
          warn(String("loc: ", loc.lossy(opts.roots[i]), ": ", why))
          readable = false
      return 2 if not readable
      sums = loc.count_trees(table, opts, <checked) catch |e|
        warn(String("loc: ", e))
        return 1
      report = loc.report(table, <sums, opts.only_lang())
      say(report.json() if opts.json else report.table(not opts.no_color and terminal()))
      0

# `print` adds the last newline.
sub say(out: String)
  print(out[..out.len - 1])

fun terminal() -> Bool
  tty: I32 = 0
  raw
    tty = isatty(1)
  return false if tty == 0
  if os.env("NO_COLOR") as v
    return false if v.len > 0
  if os.env("TERM") as term
    return false if term == "dumb"
  true
